# 万象量化AI — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== 服务器 ==========
HOST=127.0.0.1
PORT=8080

# ========== 安全 ==========
# 安装时自动生成，也可手动指定（至少32字符随机串）
SECRET_KEY=

# ========== DeepSeek V4 ==========
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ========== 腾讯混元 Hy3（TokenHub 平台） ==========
HUNYUAN_API_KEY=sk-your-hunyuan-key-from-tokenhub

# ========== AI 参数 ==========
AI_DECISION_INTERVAL=60
AI_DEBATE_ROUNDS=2

# ========== 风控（全局默认） ==========
RISK_MAX_POSITION_LOTS=1.0
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_DRAWDOWN_PCT=20.0
